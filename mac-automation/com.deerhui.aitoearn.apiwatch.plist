<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deerhui.aitoearn.apiwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/你的用户名/aitoearn-automation/check_api.py</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>/Users/你的用户名/aitoearn-automation/logs/apiwatch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/你的用户名/aitoearn-automation/logs/apiwatch.err.log</string>
</dict>
</plist>
